# Environment Configuration
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_flows
MONGODB_URL=mongodb://admin:admin@localhost:27017/whatsapp_flows_library?authSource=admin
REDIS_URL=redis://:redis123@localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Meta WhatsApp Business API
META_ACCESS_TOKEN=your-meta-access-token
META_BUSINESS_ACCOUNT_ID=your-business-account-id
META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
META_API_VERSION=v22.0
META_API_BASE_URL=https://graph.facebook.com

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf
UPLOAD_PATH=uploads
CDN_BASE_URL=https://your-cdn-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=true

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_FILE_PATH=logs/app.log

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-change-in-production
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

# WebSocket Configuration
WS_PORT=3002
WS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Monitoring and Health Checks
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# External Services
VIRUS_SCAN_ENABLED=false
VIRUS_SCAN_API_KEY=your-virus-scan-api-key
EMAIL_SERVICE_API_KEY=your-email-service-api-key
NOTIFICATION_SERVICE_URL=https://your-notification-service.com