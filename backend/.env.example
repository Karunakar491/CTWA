# WhatsApp Flow Backend Environment Configuration
# Copy this file to .env and replace the placeholder values with your actual credentials

# Meta WhatsApp Business API Configuration
META_ACCESS_TOKEN=your_access_token_here
META_WABA_ID=your_whatsapp_business_account_id_here
META_PHONE_NUMBER_ID=your_phone_number_id_here
META_API_VERSION=v18.0

# Webhook Configuration
META_WEBHOOK_VERIFY_TOKEN=whatsapp-flow-webhook-token

# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# File Upload Configuration
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880